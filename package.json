{
  "name": "ares",
  "private": true,
  "version": "0.1.0",
  "description": "ARES - e-Kanban Supplier (order dari konsumsi, Order Sheet & kanban, portal supplier, receiving scan, GR ke SAP)",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @ares/db db:generate",
    "db:migrate": "pnpm --filter @ares/db db:migrate",
    "db:push": "pnpm --filter @ares/db db:push",
    "db:studio": "pnpm --filter @ares/db db:studio",
    "db:seed": "pnpm --filter @ares/db db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "@types/node": "22.10.5",
    "prettier": "3.4.2"
  }
}
