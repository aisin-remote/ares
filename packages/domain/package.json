{
  "name": "@ares/domain",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@ares/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.5",
    "tsup": "8.3.5"
  },
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ]
}
