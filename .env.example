# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Jakarta
# Data contoh dua supplier dan PO hanya untuk server demo/pilot.
SEED_DEMO=off

# ─── Database utama (MySQL 8.4) ─────────────────────────────────────────────
# Dev lokal (docker compose up -d):
DATABASE_URL="mysql://ares:ares@127.0.0.1:3306/ares"
# Produksi: user MySQL terpisah dengan hak SELECT saja untuk proses Next.js.
# Dev boleh sama; bila kosong otomatis memakai DATABASE_URL.
WEB_DATABASE_URL="mysql://ares:ares@127.0.0.1:3306/ares"
# Produksi on-prem: isi di .env (tidak ikut ter-commit), bukan di file ini.

# ─── Valkey (queue BullMQ, pub/sub realtime) ────────────────────────────────
# Valkey = fork Redis berlisensi BSD; protokol identik, skema URL tetap redis://.
REDIS_URL="redis://127.0.0.1:6379"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Ganti sebelum deploy: openssl rand -base64 48
JWT_SECRET="ganti-dengan-rahasia-acak-minimal-48-karakter"
JWT_EXPIRES_IN="8h"
DEVICE_JWT_EXPIRES_IN="365d"
JWT_ISSUER="ares-api"
JWT_AUDIENCE="ares-clients"
# 0 bila API tidak di belakang proxy; 1 untuk satu reverse proxy Nginx/Caddy.
TRUST_PROXY_HOPS=0
API_BODY_LIMIT="256kb"
BCRYPT_ROUNDS=12
# Wajib 15–72 byte saat seed pertama di NODE_ENV=production.
ADMIN_INITIAL_PASSWORD=""
# Wajib 15–72 byte bila produksi sengaja memakai SEED_DEMO=on.
DEMO_INTERNAL_PASSWORD=""
DEMO_SUPPLIER_PASSWORD=""
# Pairing monitor receiving. Produksi wajib memakai token acak yang panjang;
# bila kosong perangkat tidak dibuat. Demo lokal memakai token default monitor123.
DISPLAY_DEVICE_CODE="RECEIVING-TV-01"
DISPLAY_DEVICE_TOKEN=""

# ─── MES: API hasil produksi (PRD 8.2) ──────────────────────────────────────
# ARES MENARIK hasil produksi dari sini lewat job mes-sync (cursor per record).
# Biarkan false sampai kontrak API-nya disepakati; dashboard menampilkan
# waktu tarik terakhir.
MES_GATEWAY=fake
MES_SYNC_ENABLED=false
MES_SYNC_INTERVAL_SEC=120
MES_API_URL=""
MES_API_TOKEN=""

# ─── SAP (PRD 8.1) ──────────────────────────────────────────────────────────
# Dorong GR ke SAP lewat tabel staging MS SQL (pola outbox → sap-writer).
# `fake` menyelesaikan kiriman dengan nomor FAKE-<id>, cocok untuk dev/pilot.
# Gunakan `mssql` hanya setelah kontrak tabel staging siap.
SAP_GATEWAY=fake
# Biarkan false sampai bentuk tabel tujuan disepakati tim SAP. Selama false,
# dokumen tetap dikumpulkan di TT_SAP_OUTBOX dan tunggakannya terlihat di /sap.
SAP_MSSQL_ENABLED=false
SAP_MSSQL_HOST=""
SAP_MSSQL_PORT=1433
SAP_MSSQL_INSTANCE=""
SAP_MSSQL_DATABASE=""
SAP_MSSQL_USER=""
SAP_MSSQL_PASSWORD=""
# Storage location tujuan GR dan stok WH (PRD 8.1); WH00 hanya placeholder (PRD §13).
SAP_SLOC="WH00"

# Jam job snapshot stok (F-41). Default 00.20 jam pabrik: mutasi kemarin sudah
# lengkap, shift pagi belum membuka layar Stok WH.
STOCK_SNAPSHOT_CRON="20 0 * * *"

# ─── Email supplier (PRD 8.4, F-31) ─────────────────────────────────────────
# Produksi wajib mengisi SMTP_HOST karena OTP login supplier dikirim lewat email.
# Di dev, SMTP_HOST boleh kosong dan kode OTP ditulis ke log API.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ARES e-Kanban <no-reply@ares.local>"
# Khusus demo lokal: kirim OTP ke halaman login agar kolom terisi otomatis.
# API menolak opsi ini bila NODE_ENV=production.
DEMO_OTP_AUTOFILL=false

# ─── Service URLs ───────────────────────────────────────────────────────────
API_PORT=3001
# Ikat API ke loopback; reverse proxy publik meneruskan /api ke port ini.
API_HOST="127.0.0.1"
API_URL="http://127.0.0.1:3001"

# Tempat PDF picklist & kanban disimpan (F-27). Relatif ke cwd proses api.
STORAGE_DIR="./storage"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
# Fase rilis PRD §12 yang tampil di menu (1 produksi pilot, 2 dev/loop otomatis, 3 penuh).
NEXT_PUBLIC_ARES_PHASE=2
WEB_PORT=3000
WEB_ORIGIN="http://127.0.0.1:3000"
