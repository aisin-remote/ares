# ─────────────────────────────────────────────────────────────────────────────
# Jaringan kantor memblokir registry.npmjs.org (403 Forbidden dari proxy).
#
# registry.yarnpkg.com bisa diakses TAPI metadata-nya masih menunjuk tarball ke
# registry.npmjs.org, jadi install tetap gagal di tengah jalan.
# npmmirror.com menulis ulang URL tarball ke CDN-nya sendiri, sehingga jalan.
#
# CATATAN PENTING: npmmirror adalah mirror publik pihak ketiga. Untuk dipakai
# jangka panjang, minta tim infra menyiapkan registry internal (Nexus atau
# Verdaccio) yang mem-proxy npm, lalu ganti baris di bawah ini. Itu sekaligus
# menyelesaikan masalah rantai pasok dan mempercepat install seluruh tim.
# ─────────────────────────────────────────────────────────────────────────────
registry=https://registry.npmmirror.com
strict-ssl=false
auto-install-peers=true
